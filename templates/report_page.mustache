{{!
    @template mod_rollcall/report_page

    Attendance report of a roll: per student, the count of each status over the past sessions, the unmarked
    past sessions and the attendance percentage. Read only.

    Context variables required for this template:
    * cmid - course module id
    * groupid - group shown, 0 for everyone
    * reporturl - URL of report.php (action of the filter form)
    * sort, dir - current sort field and direction
    * filters - list of {value, name, selected}
    * sortlinks - list of {key, name, url, active, dir, arrow}
    * columns - list of {name, hidden}, one per status
    * rows - list of {userid, fullname, picture, categoryname, color, hascategory, counts: [{value}], unmarked,
      haswarning, percent}
    * pagingbar - HTML of the paging bar
    * nopastsessions - whether the roll has no past session
    * empty - whether there are no rows

    Example context (json):
    {
        "cmid": 6,
        "groupid": 0,
        "reporturl": "https://example.com/mod/rollcall/report.php",
        "sort": "lastname",
        "dir": "asc",
        "filters": [
            {"value": "all", "name": "All students", "selected": true},
            {"value": "regular", "name": "Regular", "selected": false}
        ],
        "sortlinks": [
            {"key": "firstname", "name": "First name", "url": "#", "active": false, "dir": "", "arrow": ""},
            {"key": "lastname", "name": "Last name", "url": "#", "active": true, "dir": "asc", "arrow": "▲"},
            {"key": "percent", "name": "Attendance", "url": "#", "active": false, "dir": "", "arrow": ""}
        ],
        "columns": [{"name": "Present (100)", "hidden": false}, {"name": "Late (50)", "hidden": false}],
        "rows": [
            {"userid": 3, "fullname": "Ana Álvarez", "picture": "", "categoryname": "Repeater", "color": "amber",
             "hascategory": true, "counts": [{"value": 5}, {"value": 1}], "unmarked": 1, "haswarning": true,
             "percent": "78.6 %"}
        ],
        "pagingbar": "",
        "nopastsessions": false,
        "empty": false
    }
}}
<div class="mod_rollcall-report">
    {{#nopastsessions}}
    <p class="alert alert-info">{{#str}}nopastsessions, mod_rollcall{{/str}}</p>
    {{/nopastsessions}}
    {{^nopastsessions}}
    <p class="text-muted">{{#str}}reporthelp, mod_rollcall{{/str}}</p>
    {{/nopastsessions}}

    <form method="get" action="{{reporturl}}" class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <input type="hidden" name="id" value="{{cmid}}">
        {{#groupid}}<input type="hidden" name="group" value="{{groupid}}">{{/groupid}}
        <input type="hidden" name="sort" value="{{sort}}">
        <input type="hidden" name="dir" value="{{dir}}">
        <label for="mod_rollcall-filter-{{uniqid}}" class="mb-0">{{#str}}filter, mod_rollcall{{/str}}</label>
        <select id="mod_rollcall-filter-{{uniqid}}" name="filter" class="form-select w-auto">
            {{#filters}}
            <option value="{{value}}"{{#selected}} selected{{/selected}}>{{{name}}}</option>
            {{/filters}}
        </select>
        <button type="submit" class="btn btn-secondary">{{#str}}apply, mod_rollcall{{/str}}</button>
    </form>

    {{#empty}}
    <p class="alert alert-info">{{#str}}nostudents, mod_rollcall{{/str}}</p>
    {{/empty}}
    {{^empty}}
    <div class="table-responsive">
    <table class="table generaltable mod_rollcall-table">
        <thead>
            <tr>
                <th scope="col">
                    {{#sortlinks}}
                    <a href="{{url}}"{{#active}} aria-current="true"{{/active}} class="me-2">{{name}}{{#active}} <span aria-hidden="true">{{arrow}}</span>{{/active}}</a>
                    {{/sortlinks}}
                </th>
                {{#columns}}
                <th scope="col" class="text-end{{#hidden}} dimmed_text{{/hidden}}">{{{name}}}</th>
                {{/columns}}
                <th scope="col" class="text-end">{{#str}}unmarked, mod_rollcall{{/str}}</th>
                <th scope="col" class="text-end">{{#str}}attendancepercent, mod_rollcall{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            <tr{{#color}} class="mod_rollcall-row-{{color}}"{{/color}}>
                <td>
                    {{{picture}}}
                    <span class="mod_rollcall-fullname">{{fullname}}</span>
                    {{#hascategory}}<span class="badge{{#color}} mod_rollcall-badge-{{color}}{{/color}} ms-1">{{{categoryname}}}</span>{{/hascategory}}
                </td>
                {{#counts}}
                <td class="text-end">{{value}}</td>
                {{/counts}}
                <td class="text-end text-nowrap">
                    {{unmarked}}{{#haswarning}} {{#pix}}i/warning, core, {{#str}}unmarkedwarning, mod_rollcall{{/str}}{{/pix}}{{/haswarning}}
                </td>
                <td class="text-end text-nowrap">
                    {{percent}}{{#haswarning}} {{#pix}}i/warning, core, {{#str}}unmarkedwarning, mod_rollcall{{/str}}{{/pix}}{{/haswarning}}
                </td>
            </tr>
            {{/rows}}
        </tbody>
    </table>
    </div>

    {{{pagingbar}}}
    {{/empty}}
</div>
